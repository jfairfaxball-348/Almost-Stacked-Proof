/-! The exact CLEAR losing layers of G9 for masses 1..15 (generated by tools/s017_gen_layers.py). -/

@[expose] public section

namespace AlmostStacked.G9Data

theorem clear_layer_1 : ∀ c : Fin 9 → ℕ, size c = 1 →
    (KTree.nil.Contains (enc c) ↔ ¬ Wins G9 (fun d => size d = 1) c) :=
  layer_one (fun _ h => h)

theorem clear_layer_2 : ∀ c : Fin 9 → ℕ, size c = 2 →
    ((Data.G9Clear2).Contains (enc c) ↔ ¬ Wins G9 (fun d => size d = 1) c) :=
  layer_step setup (goodClear_spec 9) (by norm_num) (by norm_num) (KTree.ordered_nil _ _) clear_layer_1 clear_check_2

theorem clear_layer_3 : ∀ c : Fin 9 → ℕ, size c = 3 →
    ((Data.G9Clear3).Contains (enc c) ↔ ¬ Wins G9 (fun d => size d = 1) c) :=
  layer_step setup (goodClear_spec 9) (by norm_num) (by norm_num) (by have h := clear_check_2; simp only [layerB, Bool.and_eq_true] at h; exact h.1) clear_layer_2 clear_check_3

