/-! The exact STACK losing layers of G9 for masses 1..15 (generated by tools/s017_gen_layers.py). -/

@[expose] public section

namespace AlmostStacked.G9Data

theorem stack_layer_1 : ∀ c : Fin 9 → ℕ, size c = 1 →
    (KTree.nil.Contains (enc c) ↔ ¬ Wins G9 IsStacked c) :=
  layer_one (fun _ h => isStacked_of_size_one h)

theorem stack_layer_2 : ∀ c : Fin 9 → ℕ, size c = 2 →
    ((Data.G9Stack2).Contains (enc c) ↔ ¬ Wins G9 IsStacked c) :=
  layer_step setup (goodStack_spec 9) (by norm_num) (by norm_num) (KTree.ordered_nil _ _) stack_layer_1 stack_check_2

theorem stack_layer_3 : ∀ c : Fin 9 → ℕ, size c = 3 →
    ((Data.G9Stack3).Contains (enc c) ↔ ¬ Wins G9 IsStacked c) :=
  layer_step setup (goodStack_spec 9) (by norm_num) (by norm_num) (by have h := stack_check_2; simp only [layerB, Bool.and_eq_true] at h; exact h.1) stack_layer_2 stack_check_3

